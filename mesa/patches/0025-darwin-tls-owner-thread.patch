    _mesa_glapi_tls_Dispatch =
       tbl ? tbl : (struct _glapi_table *)table_noop_array;
+#if defined(__APPLE__) && defined(__ppc__)
+   rdn_tls_set_dispatch(_mesa_glapi_tls_Dispatch);
+#endif
 }
 
