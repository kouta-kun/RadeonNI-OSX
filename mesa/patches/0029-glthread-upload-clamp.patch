+#if defined(__APPLE__) && defined(__ppc__)
+#include <setjmp.h>
+#include <signal.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+/*
+ * osx-gpu: a program may pass glDrawElements indices (or vertex arrays,
+ * through the index range) longer than the memory behind them: on real
+ * hardware the extra is read as garbage and nothing happens, but glthread
+ * copies the range and the copy runs off the end of the mapping (The Sims 2
+ * does it every frame in a lot). The copy of a range that crosses a page
+ * boundary is guarded: a SIGSEGV/SIGBUS inside it ends the copy there. A
+ * copy inside one page cannot cross into unmapped memory and is not
+ * guarded. RDN_UPLOAD_GUARD=0 turns the guard off. Cost without a fault: a
+ * sigsetjmp, no system call.
+ */
+static sigjmp_buf rdn_guard_jb;
+static volatile int rdn_guard_busy;
+static volatile uintptr_t rdn_guard_addr;
+static pthread_t rdn_guard_thread;
+static struct sigaction rdn_old_segv, rdn_old_bus;
+static int rdn_guard_state;      /* 0 not set up, 1 on, -1 off */
+static unsigned rdn_guard_faults;
+
+static void
+rdn_guard_handler(int sig, siginfo_t *info, void *uc)
+{
+   if (rdn_guard_busy && pthread_equal(pthread_self(), rdn_guard_thread)) {
+      sigset_t set;
+
+      rdn_guard_addr = (uintptr_t)info->si_addr;
+      sigemptyset(&set);
+      sigaddset(&set, SIGSEGV);
+      sigaddset(&set, SIGBUS);
+      sigprocmask(SIG_UNBLOCK, &set, NULL);
+      siglongjmp(rdn_guard_jb, 1);
+   }
+   /* Not ours: give the signal back to what was there; the instruction
+    * runs again and faults into it. */
+   sigaction(sig, sig == SIGSEGV ? &rdn_old_segv : &rdn_old_bus, NULL);
+}
+
+static void
+rdn_guard_setup(void)
+{
+   const char *e = getenv("RDN_UPLOAD_GUARD");
+   struct sigaction sa;
+
+   if (e && e[0] == '0') {
+      rdn_guard_state = -1;
+      return;
+   }
+   sa.sa_sigaction = rdn_guard_handler;
+   sigemptyset(&sa.sa_mask);
+   sa.sa_flags = SA_SIGINFO;
+   sigaction(SIGSEGV, &sa, &rdn_old_segv);
+   sigaction(SIGBUS, &sa, &rdn_old_bus);
+   rdn_guard_state = 1;
+}
+
+static void
+rdn_guarded_memcpy(void *dst, const void *src, size_t n)
+{
+   if (((uintptr_t)src & 0xfff) + n <= 0x1000) {
+      memcpy(dst, src, n);
+      return;
+   }
+   if (!rdn_guard_state)
+      rdn_guard_setup();
+   if (rdn_guard_state < 0 || !__sync_bool_compare_and_swap(&rdn_guard_busy, 0, 1)) {
+      memcpy(dst, src, n);
+      return;
+   }
+   rdn_guard_thread = pthread_self();
+   if (sigsetjmp(rdn_guard_jb, 0) == 0) {
+      memcpy(dst, src, n);
+      rdn_guard_busy = 0;
+   } else {
+      uintptr_t page = rdn_guard_addr & ~(uintptr_t)0xfff;
+
+      rdn_guard_busy = 0;
+      /* The fast copy stops before it stores its last blocks: copy what
+       * is readable, up to the page that faulted. */
+      if (rdn_guard_addr >= (uintptr_t)src && rdn_guard_addr < (uintptr_t)src + n &&
+          page > (uintptr_t)src)
+         memcpy(dst, src, page - (uintptr_t)src);
+      if (rdn_guard_faults++ < 20) {
+         FILE *f = fopen("/tmp/rdn-upload-clamp.txt", "a");
+         if (f) {
+            fprintf(f, "guard: copy of %lu bytes from %p stopped at a fault\n",
+                    (unsigned long)n, src);
+            fclose(f);
+         }
+      }
+   }
+}
+#define RDN_COPY(d, s, n) rdn_guarded_memcpy(d, s, n)
+#else
+#define RDN_COPY(d, s, n) memcpy(d, s, n)
+#endif
+
